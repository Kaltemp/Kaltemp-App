# backend/.env
# Copia este archivo como "backend/.env" (sin el .example) y completa
# tus valores reales. Se carga automáticamente al arrancar uvicorn Y al
# correr cualquier script de backend/sync/*.py -- no hace falta exportar
# variables a mano en cada terminal nueva.

# Ruta al archivo real de la base de datos (ajusta a tu ruta en Windows)
DUCKDB_PATH=C:\kaltemp_app\kaltemp-backend-fastapi-v2\kaltemp_matrix.duckdb

# Origen permitido para CORS (el puerto donde corre "npm run dev")
ALLOWED_ORIGINS=http://localhost:3000

# Token de acceso a la API de Bsale (solo lo usan los scripts de backend/sync/)
BSALE_ACCESS_TOKEN=tu_token_real_aqui

# Ventana de días hacia atrás que revisa sync_pendientes_despacho.py (opcional)
PXD_DIAS_ATRAS=180

# Días de desfase para marcar alerta=true en notas de crédito (opcional)
NC_DIAS_DESFASE_ALERTA=1
